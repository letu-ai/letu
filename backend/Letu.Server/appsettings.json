{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "System": "Warning",
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        }
    },
    "App": {
        "DemonstrationMode": false,
        "AccountManyLogin": true
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://*:80"
            }
            // "Https": {
            //     "Url": "https://*:443",
            //     "Certificate": {
            //      "Path": "your_domain.pfx",
            //      "Password": "your_secure_password"
            //     }
            // }
        }
    },
    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5432;Database=letu;User ID=postgres;Password=123456;"
    },
    "Redis": {
        "IsEnabled": true,
        "Configuration": "127.0.0.1:6379"
    },
    "CorsOrigins": [
        "http://localhost:8080"
    ],
    // 可信代理
    "ForwardedHeaders": {
        "ForwardedHeaders": [
            "XForwardedFor",
            "XForwardedProto",
            "XForwardedHost"
        ],
        "KnownProxies": [
            "172.18.0.1"
        ], // 日志出现Unknown proxy: XXXXXX中的实际代理 IP（必加）
        "KnownIPNetworks": [
            "172.18.0.0/16"
        ] // 可选：Docker 网段（避免 IP 变动再改配置）
    },
    "Jwt": {
        // ========== 令牌签发配置 (生成JWT) ==========
        "Issuance": {
            "Issuer": "https://localhost:5051", // 签发者
            "Audience": "api", // 接收方
            "Subject": "api-access", // 主题
            "ExpirySeconds": 3600, // 令牌有效时间（秒）
            "SecurityKey": "**********************签名密钥，必须大于32个字符**********************", // 签名密钥，必须大于32个字符
            "Algorithm": "HS256" // 签名算法（可选）
        },
        // ========== 令牌认证配置 (验证JWT) ==========
        "Validation": {
            "RequireHttps": true, // 是否需要HTTPS（生产环境用）
            "ValidateIssuer": true,
            "ValidIssuer": "https://localhost:5051", // 应与签发Issuer一致
            "ValidateAudience": true,
            "ValidAudience": "api", // 应与签发Audience一致
            "ValidateLifetime": true,
            "ClockSkewSeconds": 30, // 时钟偏移容差（秒）
            "RequireSignedTokens": true, // 必须验证签名
            "SecurityKey": "**********************验证密钥（与签发一致）s**********************", // 验证密钥（与签发一致）
            "ValidAlgorithms": [
                "HS256"
            ] // 允许的签名算法列表
        }
    },
    "Snowflake": {
        "WorkerId": 1,
        "DataCenterId": 4
    },
    "Mqtt": {
        "IsEnabled": true,
        "Port": 1883,
        "Username": "",
        "Password": ""
    },
    "LogManagement": {
        "System": {
            "LogDirectory": "logs",
            "RetentionDays": 31,
            "CompressAfterDays": 7
        },
        "AuditLog": {
            "RetentionDays": 90
        },
        "BusinessLog": {
            "RetentionDays": 90
        },
        "CleanupScheduleCron": "0 0 2 * * ?"
    }
}