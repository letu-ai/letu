{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "Default": "Host=postgres;Port=5432;Database=letu;User ID=postgres;Password=123456;"
    },
    "Redis": {
        "IsEnabled": true,
        "Configuration": "redis:6379"
    },
    "Jwt": {
        // ========== 令牌签发配置 (生成JWT) ==========
        "Issuance": {
            "Issuer": "http://localhost:80", // 签发者
            "Audience": "api", // 接收方
            "Subject": "api-access", // 主题
            "ExpirySeconds": 3600, // 令牌有效时间（秒）
            "SecurityKey": "e3b0c44298fc1c149afbf4c8996fb92427aksdf2kl23*(2343345sdxfsf11111", // 签名密钥，必须大于32个字符
            "Algorithm": "HS256" // 签名算法（可选）
        },
        // ========== 令牌认证配置 (验证JWT) ==========
        "Validation": {
            "RequireHttps": false, // 是否需要HTTPS（生产环境用）
            "ValidateIssuer": true,
            "ValidIssuer": "http://localhost:80", // 应与签发Issuer一致
            "ValidateAudience": true,
            "ValidAudience": "api", // 应与签发Audience一致
            "ValidateLifetime": true,
            "ClockSkewSeconds": 30, // 时钟偏移容差（秒）
            "RequireSignedTokens": true, // 必须验证签名
            "SecurityKey": "e3b0c44298fc1c149afbf4c8996fb92427aksdf2kl23*(2343345sdxfsf11111", // 验证密钥（与签发一致）
            "ValidAlgorithms": [
                "HS256"
            ] // 允许的签名算法列表
        }
    }
}