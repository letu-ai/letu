# Letu 应用环境变量配置示例
# 复制此文件为 .env 并修改为实际的配置值

# ====================
# 必需的环境变量
# ====================

# PostgreSQL 数据库连接字符串
# 格式: Host=主机地址;Port=端口;Database=数据库名;User ID=用户名;Password=密码;
ConnectionStrings__Default=Host=localhost;Port=5432;Database=letu;User ID=postgres;Password=123456;

# Redis 缓存服务器配置
# 格式: 主机地址:端口 (无密码)
# 格式: 主机地址:端口,password=密码 (有密码)
Redis__Configuration=127.0.0.1:6379
# Redis__Configuration=127.0.0.1:6379,password=redis123

# ====================
# 可选的环境变量
# ====================

# 运行环境 (Development/Staging/Production)
ASPNETCORE_ENVIRONMENT=Production

# ====================
# Docker Compose 使用说明
# ====================
# 1. 如果使用 docker-compose.yml 中的 PostgreSQL 服务:
#    ConnectionStrings__Default=Host=postgres;Port=5432;Database=letu;User ID=postgres;Password=postgres123;
#
# 2. 如果使用 docker-compose.yml 中的 Redis 服务 (带密码):
#    Redis__Configuration=redis:6379,password=redis123
#
# 3. 如果使用外部数据库和 Redis:
#    使用实际的外部服务地址和凭据
#
# 4. 数据目录说明:
#    - ./data/app/logs: 应用日志
#    - ./data/app/upload: 上传文件
#    - ./data/postgres/data: PostgreSQL 数据
#    - ./data/redis/data: Redis 数据