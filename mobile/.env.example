# API 服务器配置
# 开发环境 - Android模拟器使用10.0.2.2访问localhost
# 开发环境 - iOS模拟器使用localhost
# 真机调试 - 使用开发机器的局域网IP地址（如：192.168.1.100）
API_BASE_URL_ANDROID_DEV=http://10.0.2.2:5050
API_BASE_URL_IOS_DEV=http://localhost:5050
API_BASE_URL_DEVICE=http://192.168.1.100:5050

# 生产环境API地址
API_BASE_URL_PROD=https://your-production-api.com
